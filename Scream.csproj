<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>Scream</AssemblyName>
    <RootNamespace>Scream</RootNamespace>
    <ApplicationManifest>host\app.manifest</ApplicationManifest>
    <ApplicationIcon>host\scream.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <Product>Scream Adaptive Wallpaper</Product>
    <Company>Scream</Company>
    <Description>Adaptive Studio Ghibli Live Wallpaper for Windows Desktop</Description>
    <ScreamUpdateRepo Condition="'$(ScreamUpdateRepo)' == ''">lecongchien/chisaln</ScreamUpdateRepo>
    <ScreamUpdateManifestUrl Condition="'$(ScreamUpdateManifestUrl)' == ''">https://github.com/$(ScreamUpdateRepo)/releases/latest/download/latest.json</ScreamUpdateManifestUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ScreamUpdateManifestUrl" Value="$(ScreamUpdateManifestUrl)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="web\**\*" Exclude="web\serve.mjs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
